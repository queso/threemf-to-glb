{
  "name": "threemf-to-glb",
  "version": "0.1.0",
  "description": "Bake a Bambu Lab 3MF (geometry, paint_color RLE, plate layout) into a glTF binary (.glb): a pure library plus a CLI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "threemf-to-glb": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "check": "bun run typecheck && biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "3mf",
    "glb",
    "gltf",
    "bambu",
    "bambu-lab",
    "3d-printing",
    "converter"
  ],
  "license": "MIT",
  "author": "Josh Owens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/queso/threemf-to-glb.git"
  },
  "homepage": "https://github.com/queso/threemf-to-glb#readme",
  "bugs": {
    "url": "https://github.com/queso/threemf-to-glb/issues"
  }
}
